{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(cd:*)",
      "Bash(npm run:*)",
      "Bash(awk '{print $2}')",
      "Bash(xargs -I {} basename {})",
      "Bash(awk -F'AppLocales\\\\.' '{print $2}')",
      "Bash(sed 's/\\\\.tr\\(\\).*//')",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "PowerShell(npx astro build 2>&1 | Select-Object -Last 30)",
      "PowerShell(npx astro build 2>&1 | Select-Object -Last 20)",
      "PowerShell(Test-Path *)",
      "PowerShell(npx astro build 2>&1 | Select-Object -Last 5)"
    ]
  }
}
